create_clock -name wclk_i -period 2.5 [get_ports wclk_i]
set_property HD.CLK_SRC BUFGCTRL_X0Y0 [get_ports wclk_i]
create_clock -name rclk_i -period 2.5 [get_ports rclk_i]
set_property HD.CLK_SRC BUFGCTRL_X0Y1 [get_ports rclk_i]
set_clock_groups -asynchronous -group [get_clocks wclk_i] -group [get_clocks rclk_i]
set_input_delay -clock wclk_i 0 [get_ports {wrst_ni wr_en_i wr_data_i[*]}]
set_input_delay -clock rclk_i 0 [get_ports {rrst_ni rd_en_i}]
set_false_path -from [get_ports -filter {DIRECTION == IN && NAME !~ "*clk*"}]
set_false_path -to [get_ports -filter {DIRECTION == OUT}]
