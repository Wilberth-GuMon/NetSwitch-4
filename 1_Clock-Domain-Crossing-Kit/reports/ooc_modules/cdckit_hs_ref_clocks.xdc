create_clock -name clk_src_i -period 6.4 [get_ports clk_src_i]
set_property HD.CLK_SRC BUFGCTRL_X0Y0 [get_ports clk_src_i]
create_clock -name clk_dst_i -period 10.0 [get_ports clk_dst_i]
set_property HD.CLK_SRC BUFGCTRL_X0Y1 [get_ports clk_dst_i]
set_clock_groups -asynchronous -group [get_clocks clk_src_i] -group [get_clocks clk_dst_i]
set_input_delay -clock clk_src_i 0 [get_ports {rst_src_ni src_valid_i src_data_i[*]}]
set_input_delay -clock clk_dst_i 0 [get_ports {rst_dst_ni}]
set_false_path -from [get_ports -filter {DIRECTION == IN && NAME !~ "*clk*"}]
set_false_path -to [get_ports -filter {DIRECTION == OUT}]
